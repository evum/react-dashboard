# Порт клиента на хосте (nginx)
CLIENT_PORT=8080

# Порт API на хосте
SERVER_PORT=3000

# Локальный Vite (`npm run dev`) проксирует /api сюда
API_URL=http://127.0.0.1:3000
CLIENT_HOST=127.0.0.1
VITE_PORT=5173

# Мок-сервер: как часто и сколько узлов меняют метрики
CHANGE_INTERVAL=4000
MAX_CHANGED_NODES=3
CORS_ORIGIN=*
